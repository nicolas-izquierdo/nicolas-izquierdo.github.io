---
# Overrides jekyll-feed's generated feed.xml (the plugin skips generation when this file
# exists). The site has no blog, so the feed is intentionally empty; this file only exists
# so the auto-generated one does not carry the literal site title "blank".
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.lang }}">
  <id>{{ '/feed.xml' | absolute_url }}</id>
  <title>{{ site.first_name }} {{ site.last_name }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author><name>{{ site.first_name }} {{ site.last_name }}</name></author>
</feed>
